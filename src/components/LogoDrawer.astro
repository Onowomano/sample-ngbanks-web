<div
  id="logo-drawer"
  class="ld"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="ld-title"
>
  <div class="ld__backdrop" data-ld-close></div>
  <div class="ld__panel">
    <div class="ld__header">
      <h2 id="ld-title" class="ld__title"></h2>
      <button
        type="button"
        class="ld__close"
        aria-label="Close"
        data-ld-close
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M15 5L5 15M5 5L15 15"
            stroke="#04000A"
            stroke-width="1.66667"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <div class="ld__preview-wrap" data-style="circle">
      <div class="ld__preview">
        <img id="ld-preview" alt="" width="120" height="120" />
      </div>
    </div>

    <div class="ld__actions">
      <button type="button" class="ld__btn" data-action="copy-png">
        Copy PNG
      </button>
      <button type="button" class="ld__btn" data-action="copy-svg">
        Copy SVG
      </button>
      <button type="button" class="ld__btn" data-action="download-png">
        Download PNG
      </button>
      <button type="button" class="ld__btn" data-action="download-svg">
        Download SVG
      </button>
    </div>
  </div>

  <div id="ld-toast" class="ld__toast" role="status" aria-live="polite" hidden>
  </div>
</div>

<script>
  import { track } from "@vercel/analytics";
  import { copyLogo, downloadLogo } from "../lib/logoActions";
  import type { Bank, BankSelectDetail, LogoFormat } from "../types/bank";

  const drawer = document.getElementById("logo-drawer")!;
  const titleEl = document.getElementById("ld-title")!;
  const previewEl = document.getElementById("ld-preview") as HTMLImageElement;
  const previewWrap = drawer.querySelector(".ld__preview-wrap") as HTMLElement;
  const toastEl = document.getElementById("ld-toast")!;
  const actionButtons = drawer.querySelectorAll<HTMLButtonElement>(".ld__btn");

  let currentBank: Bank | null = null;
  let busy = false;
  let toastTimer: ReturnType<typeof setTimeout> | null = null;
  let lastFocused: HTMLElement | null = null;

  function showToast(message: string, ok: boolean) {
    toastEl.textContent = message;
    toastEl.hidden = false;
    toastEl.dataset.ok = String(ok);
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toastEl.hidden = true;
    }, 2800);
  }

  function setBusy(next: boolean) {
    busy = next;
    actionButtons.forEach((btn) => {
      btn.disabled = next;
    });
  }

  function openDrawer(detail: BankSelectDetail) {
    currentBank = detail.bank;
    titleEl.textContent = detail.bank.name;
    previewEl.src = detail.bank.logos.png;
    previewEl.alt = detail.bank.name;
    previewWrap.dataset.style = detail.style;

    lastFocused = document.activeElement as HTMLElement | null;
    drawer.hidden = false;
    document.body.style.overflow = "hidden";
    drawer.querySelector<HTMLButtonElement>(".ld__close")?.focus();
  }

  function closeDrawer() {
    drawer.hidden = true;
    document.body.style.overflow = "";
    currentBank = null;
    lastFocused?.focus();
    lastFocused = null;
  }

  async function runAction(
    action: "copy" | "download",
    format: LogoFormat,
    label: string,
  ) {
    if (!currentBank || busy) return;

    const url = currentBank.logos[format];
    if (!url) {
      showToast(`${format.toUpperCase()} not available for this bank`, false);
      return;
    }

    setBusy(true);
    track(`${label}`);

    const result =
      action === "copy"
        ? await copyLogo(url, format)
        : await downloadLogo(url, currentBank.name, format);

    showToast(result.message, result.ok);
    setBusy(false);
  }

  window.addEventListener("bank:select", (e) => {
    openDrawer((e as CustomEvent<BankSelectDetail>).detail);
  });

  drawer.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("[data-ld-close]")) {
      closeDrawer();
      return;
    }

    const btn = target.closest<HTMLButtonElement>("[data-action]");
    if (!btn) return;

    const action = btn.dataset.action;
    if (action === "copy-png") runAction("copy", "png", "Logo Copy PNG");
    if (action === "copy-svg") runAction("copy", "svg", "Logo Copy SVG");
    if (action === "download-png")
      runAction("download", "png", "Logo Download PNG");
    if (action === "download-svg")
      runAction("download", "svg", "Logo Download SVG");
  });

  document.addEventListener("keydown", (e) => {
    if (drawer.hidden) return;

    if (e.key === "Escape") {
      e.preventDefault();
      closeDrawer();
      return;
    }

    if (e.key !== "Tab") return;

    const focusable = drawer.querySelectorAll<HTMLElement>(
      'button:not([disabled]), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
    );
    if (!focusable.length) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>

<style is:global>
  .ld {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ld[hidden] {
    display: none;
  }

  .ld__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 7, 18, 0.45);
  }

  .ld__panel {
    position: relative;
    width: min(100%, 360px);
    background: #ffffff;
    border: 1px solid #eaeaea;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ld__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .ld__title {
    font-size: 18px;
    font-weight: 500;
    color: #030712;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
    flex: 1;
    min-width: 0;
  }

  .ld__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    background: #ffffff;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.15s ease;
  }

  .ld__close:hover {
    border-color: #d1d5db;
  }

  .ld__preview-wrap {
    display: flex;
    justify-content: center;
  }

  .ld__preview {
    width: 120px;
    height: 120px;
    overflow: hidden;
    border: 1px solid #e6e7ea;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  .ld__preview-wrap[data-style="circle"] .ld__preview {
    border-radius: 50%;
  }

  .ld__preview-wrap[data-style="square"] .ld__preview {
    border-radius: 8px;
  }

  .ld__preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ld__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .ld__btn {
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background: #ffffff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 400;
    color: #030712;
    letter-spacing: -0.02em;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .ld__btn:hover:not(:disabled) {
    border-color: #6b7280;
  }

  .ld__btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .ld__toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: #ffffff;
    background: #030712;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    z-index: 1001;
    max-width: calc(100% - 40px);
    text-align: center;
  }

  .ld__toast[data-ok="false"] {
    background: #991b1b;
  }

  .ld__toast[hidden] {
    display: none;
  }

  @media (max-width: 768px) {
    .ld {
      align-items: flex-end;
      padding: 0;
    }

    .ld__panel {
      width: 100%;
      border-radius: 16px 16px 0 0;
      border-bottom: none;
      padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
    }
  }
</style>
